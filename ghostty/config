window-decoration = false
theme = Batman
background = 181818
foreground = c0c0c0
font-family = Iosevka

app-notifications = no-clipboard-copy

keybind = ctrl+enter=unbind
keybind = f11=toggle_fullscreen

custom-shader = ~/.config/ghostty/shaders/in-game-crt-cursor.glsl
custom-shader = ~/.config/ghostty/shaders/bettercrt.glsl
#custom-shader = ~/.config/ghostty/shaders/in-game-crt.glsl
custom-shader = ~/.config/ghostty/shaders/tft.glsl
#custom-shader = ~/.config/ghostty/shaders/bloom.glsl
#custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl


config-file = ?auto/theme.ghostty
