#exec dbus-update-activation-environment DISPLAY I3SOCK SWAYSOCK WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway ### Variables

set $mod Mod4
set $term foot
set $left h
set $right l
set $up k
set $down j

floating_modifier $mod

#output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

### Key bindings
bindsym --no-repeat $mod+Return exec $term
bindsym Mod1+F4 kill
for_window [class="^Nsxiv$"] floating enable, resize set 1000 700, move position center

bindsym $mod+d exec wexe
#bindsym $mod+e exec wemjpkr
#bindsym $mod+o exec xwall
bindsym $mod+Shift+s exec grim -g "$(slurp)" - | swappy -f -
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

floating_modifier $mod normal

bindsym $mod+$left focus left
bindsym $mod+$right focus right
bindsym $mod+$up focus up
bindsym $mod+$down focus down

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$down move down

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4

bindsym $mod+Y workspace Y
bindsym $mod+Shift+Y move container to workspace Y; workspace  Y

bindsym $mod+F workspace F
bindsym $mod+Shift+F move container to workspace F; workspace  F

bindsym $mod+T workspace T
bindsym $mod+Shift+T move container to workspace T; workspace  T

# Layout
workspace_layout tabbed

bindsym $mod+a focus parent
bindsym $mod+v split v
bindsym $mod+g split h
bindsym $mod+Shift+space floating toggle

output eDP-1 scale 1.25
#output eDP-1 scale_filter nearest

seat seat0 xcursor_theme FernBLZ 36
input type:touchpad {
    tap enabled
    drag_lock disabled
    pointer_accel 0.5
    dwt no
}

input * {
    repeat_delay 200
    repeat_rate 30
}

### Appearance
font pango:Iosevka 11
titlebar_padding 4 1

#for_window [class=".*"] border pixel 1
for_window [class=".*"] border normal
default_border pixel 1
smart_borders on
#client.focused #5FAF9F #5FAF9F #FFFFFF #5FAF9F #5FAF9F
client.focused #ADC178 #ADC178 #FFFFFF #ADC178 #ADC178


bar {
    status_command i3status
    colors {
        focused_workspace  #ADC178 #ADC178 #FFFFFF
        active_workspace   #ADC178 #ADC178 #FFFFFF
        inactive_workspace #222222 #222222 #888888
    }
}

#bindsym $mod+Shift+c exec rec 
#bindsym $mod+Shift+o exec pkill -INT wf-recorder

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or Mod1+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym Mod1+r mode "default"
}

bindsym Mod1+r mode "resize"

bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86AudioRaiseVolume exec pamixer --increase 5 && vol
bindsym XF86AudioLowerVolume exec pamixer --decrease 5 && vol
bindsym XF86AudioMute exec pamixer --toggle-mute && vol
bindsym XF86AudioMicMute exec pamixer --default-source --toggle-mute

exec gammastep -l 0:0 -t 3500:3500
exec mako

exec run_local_startup_jobs
