### Variables
set $mod Mod4
set $term $TERMINAL_EMULATOR
set $left h
set $right l
set $up k
set $down j

floating_modifier $mod

### Key bindings
#bindsym $mod+Return exec $term
bindsym $mod+Return exec $term
bindsym Mod1+F4 kill
bindsym $mod+Shift+S exec maim -s | xclip -selection clipboard -t image/png
#bindsym $mod+o exec sxiv -t ~/opt/walls
#bindsym $mod+Shift+b exec xtouchpad
for_window [class="^Nsxiv$"] floating enable, resize set 1000 700, move position center

bindsym $mod+d exec exe
#bindsym $mod+e exec emjpkr
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes, exit' 'i3-msg exit'"

# Focus movement
bindsym $mod+$left focus left
bindsym $mod+$right focus right
bindsym $mod+$up focus up
bindsym $mod+$down focus down

# Move containers
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$down move down

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+Shift+1 move container to workspace number 1; workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+Shift+2 move container to workspace number 2; workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+Shift+3 move container to workspace number 3; workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+4 move container to workspace number 4; workspace number 4

bindsym $mod+Y workspace Y
bindsym $mod+Shift+Y move container to workspace Y; workspace  Y

bindsym $mod+F workspace F
bindsym $mod+Shift+F move container to workspace F; workspace  F

bindsym $mod+T workspace T
bindsym $mod+Shift+T move container to workspace T; workspace  T


#for_window [title="btop"] move to workspace T
#assign [class="Navigator"] 2
#assign [instance="discord.com__app"] F
#assign [instance="youtube.com"] Y

# Layout
workspace_layout tabbed

bindsym $mod+a focus parent
bindsym $mod+g split v
bindsym $mod+v split h
bindsym $mod+Shift+space floating toggle

### Appearance
font pango:Iosevka 13
#for_window [class=".*"] border pixel 1
for_window [class=".*"] border normal
default_border pixel 1
smart_borders on
#client.focused #5FAF9F #5FAF9F #FFFFFF #5FAF9F #5FAF9F
client.focused #ADC178 #ADC178 #FFFFFF #ADC178 #ADC178

bar {
    status_command i3status
}

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym $left       resize shrink width 10 px or 10 ppt
        bindsym $down       resize grow height 10 px or 10 ppt
        bindsym $up         resize shrink height 10 px or 10 ppt
        bindsym $right      resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left        resize shrink width 10 px or 10 ppt
        bindsym Down        resize grow height 10 px or 10 ppt
        bindsym Up          resize shrink height 10 px or 10 ppt
        bindsym Right       resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or Mod1+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym Mod1+r mode "default"
}

bindsym Mod1+r mode "resize"

### Media Keys
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ --limit 1.0 && vol
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && vol
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
